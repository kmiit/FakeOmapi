soong_config_module_type {
    name: "omapi_uuid_cflag_default",
    module_type: "cc_defaults",
    config_namespace: "omapi",
    value_variables: ["uuid"],
    properties: [
        "cppflags",
    ],
}

omapi_uuid_cflag_default {
    name: "omapi_uuid_cflag_default",
    soong_config_variables: {
        uuid: {
            cppflags: ["-DCUSTOM_UUID_HEXSTRING=\"%s\""],
        },
    },
}

cc_binary {
    name: "se_omapi",
    srcs: [
        "main.cpp",
        "Channel.cpp",
        "Reader.cpp",
        "Service.cpp",
        "Session.cpp",
        "Terminal.cpp",
        "internal/ByteArrayConverter.cpp",
    ],
    // This hex value is fetched from /vendor/etc/hal_uuid_map.xml
    // For A16+
    // cflags: select(soong_config_variable("omapi", "uuid"), {
    //     any @ uuid: ["-DCUSTOM_UUID_HEXSTRING=\"" + uuid + "\""],
    //     default: [],
    // }),

    // Adapt for A14
    defaults: ["omapi_uuid_cflag_default"],

    local_include_dirs: ["include"],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libutils",
        "android.hardware.secure_element-V1-ndk",
        "android.se.omapi-V1-ndk",
    ],
    recovery_available: true,
}
